# StoryInColor environment variables — client (browser) side.
# Copy to .env.local for local development. CI sets these via GitHub Actions
# secrets (see .github/workflows/deploy.yml).
#
# All NEXT_PUBLIC_* values are baked into the static build at compile time
# and ARE visible in the deployed JS bundle. Never put secrets here.

# Firebase web config — required. Get these from the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Stripe public key — required. Get from Stripe dashboard → Developers → API keys.
# Use the test publishable key (pk_test_…) for staging; live key (pk_live_…) for prod.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Site URL — optional, used by the sitemap generator. Defaults to https://storyincolor.com.
NEXT_PUBLIC_SITE_URL=https://storyincolor.com

# Facebook Pixel — optional, set to "true" to enable in non-production environments.
NEXT_PUBLIC_ENABLE_FB_PIXEL=
