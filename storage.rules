rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Server-written generation outputs — read-only for the owner. Block
    // client write so a malicious user can't overwrite their own generation
    // PNGs after the fact (and tamper with the URL referenced by the job
    // doc). Server (admin SDK) bypasses these rules.
    match /users/{userId}/generations/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Admin override via the `admin: true` custom claim.
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write, delete: if false;
    }

    // Allow users to read, write, and delete their own files
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                     && request.resource.size < 10 * 1024 * 1024  // 10MB limit
                     && request.resource.contentType.matches('image/.*');

      // Allow admin access to all user files via the `admin: true` claim.
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Public files can be read by anyone but only written by authenticated users
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Quiz funnel pending storage — unauthenticated upload (input photo)
    // and read of the blurred preview, but full output is gated behind a
    // server-only move to users/{uid}/generations/. Per QUIZ-PIVOT-SPEC.md §8.3.
    match /pending/{token}/{fileName} {
      // Anonymous upload of input.* (jpg, png, webp). Size + content-type
      // bounded. Match by prefix on filename.
      allow create: if fileName.matches('input\\..+')
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      // Blurred preview is publicly readable (it's blurred + low-res +
      // short-lived). Reveal screen fetches via Firebase download URL.
      allow read: if fileName == 'blurred.jpg';

      // Full output (output.png) and any other file: server-only.
      // Admin SDK reads + writes bypass these rules entirely.
      allow read, update, delete: if false;
    }
  }
}

