rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin access (more permissive). Source-of-truth is the `admin: true`
    // Firebase Auth custom claim. To rotate admins, set the claim via
    // Admin SDK (see CLAUDE.md § Admin) — no rule redeploy needed.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Allow admin full read access to everything
    match /{document=**} {
      allow read: if isAdmin();
    }

    // jobs and generations are written EXCLUSIVELY by the server (admin SDK
    // bypasses rules). Clients can read their own records but cannot write —
    // this prevents a malicious user from forging "complete" job docs with
    // arbitrary outputDownloadUrls. Owner-read + admin-read only.
    match /users/{userId}/jobs/{jobId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    match /users/{userId}/generations/{genId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Upload metadata remains user-owned. jobs/generations rules above are
    // intentionally stricter because those records are written by Functions.
    match /users/{userId}/uploads/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
    // Top-level user doc (fields directly on /users/{userId})
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // User credit ledger — owner can READ only. ALL writes happen via Cloud
    // Functions (admin SDK bypasses these rules): ensureUserCredits bootstrap,
    // stripeWebhook on purchase, generateForTool on deduct + refund. If the
    // owner could write here they could grant themselves unlimited balance
    // from the browser console.
    match /userCredits/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    // Per-event usage subcollection — server-only writes (admin SDK bypasses).
    // Owner can read their own audit log; client cannot forge events.
    match /userCredits/{userId}/usageEvents/{eventId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Public data
    match /public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Shared readings — public read, server-only write. The createShareLink
    // callable validates that the requester owns a complete job before
    // creating a doc here; clients must NOT be able to forge share docs
    // from the browser console (would let a malicious user point a share
    // link at any image URL they wanted).
    match /sharedReadings/{shareId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stripe webhook idempotency markers — server-only writes (admin SDK
    // bypasses these rules). No client should ever read or write these.
    match /processedStripeEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
