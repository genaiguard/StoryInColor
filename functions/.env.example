# StoryInColor Cloud Functions — runtime configuration.
#
# This file documents the structure of `functions/.env`. The real `.env`
# is gitignored and contains the actual values. Two categories:
#
#   1. SECRETS — credentials. Live in Firebase Secret Manager, NOT in
#      this file or `.env`. Loaded via `defineSecret(...)` in
#      functions/src/index.ts + generate-for-tool.ts + ensure-user-credits.ts.
#      Set via:
#        firebase functions:secrets:set <NAME>
#
#   2. ENV — non-secret runtime configuration (region strings, feature
#      flags, public IDs, recipient addresses). Goes in `functions/.env`
#      and is read via `process.env.<NAME>`.

# ============================================================================
# 1. SECRETS — set via `firebase functions:secrets:set <NAME>` (NOT here)
# ============================================================================
#
#   OPENAI_API_KEY            OpenAI API key for image generations
#   STRIPE_SECRET_KEY         sk_live_… or sk_test_… — credit purchase checkout
#   STRIPE_WEBHOOK_SECRET     whsec_… — checkout.session.completed verification
#   AWS_ACCESS_KEY_ID         SES — welcome + contact emails
#   AWS_SECRET_ACCESS_KEY     SES paired secret
#   SENDER_EMAIL_ADDRESS      SES verified sender (e.g. info@storyincolor.com)
#   META_CAPI_TOKEN           Meta Conversions API token for server-side Pixel mirror
#   GA4_MP_API_SECRET         GA4 Measurement Protocol api_secret

# ============================================================================
# 2. ENV — non-secret runtime configuration. Put real values in functions/.env
# ============================================================================

# AWS SES region. NOT a secret — region strings are public. Kept here so
# we don't burn a Firebase secret-fetch slot + cold-start time.
AWS_REGION=us-east-1

# Personal admin notification address. Receives a copy of contact-form
# submissions alongside the SENDER_EMAIL_ADDRESS. NOT a security check —
# just a recipient. If unset, contact-form mails go only to the sender.
ADMIN_NOTIFICATION_EMAIL=

# Master switch for the server-side conversion forwarding (CAPI + GA4 MP).
# When NOT "true", every dispatchServerConversion call no-ops at the gate.
STORYINCOLOR_ENABLE_SERVER_CONVERSIONS=true

# Public Pixel id, mirrors the browser Pixel value.
META_PIXEL_ID=

# GA4 measurement id, mirrors the browser gtag value.
GA4_MEASUREMENT_ID=

# Optional: Meta Test Events code. Set during validation to send CAPI
# events to the Test Events tab in Events Manager. Remove + redeploy once
# verified — leaving it set means events don't count toward production
# attribution.
# META_TEST_EVENT_CODE=

# Optional: when "true", GA4 Measurement Protocol hits go to the /debug
# endpoint that validates the payload without recording the event.
# GA4_MP_DEBUG=

# Storage bucket override. Functions normally pick up the default bucket
# from admin.app().options.storageBucket. The local emulator does NOT set
# this — export it explicitly when running `firebase emulators:start`.
GCLOUD_STORAGE_BUCKET=
