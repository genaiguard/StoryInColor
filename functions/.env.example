# StoryInColor Cloud Functions — server-only secrets.
# These are NEVER bundled into the client. They are loaded by Firebase
# Functions via `defineSecret(...)` (see functions/src/index.ts and
# generate-for-tool.ts). Set them with:
#
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#   firebase functions:secrets:set AWS_ACCESS_KEY_ID
#   firebase functions:secrets:set AWS_SECRET_ACCESS_KEY
#   firebase functions:secrets:set AWS_REGION
#   firebase functions:secrets:set SENDER_EMAIL_ADDRESS
#
# This file is documentation only — do NOT put real values here.

OPENAI_API_KEY=             # OpenAI API key for gpt-image-1 generations
STRIPE_SECRET_KEY=          # sk_live_… or sk_test_… — credit purchase checkout
STRIPE_WEBHOOK_SECRET=      # whsec_… — Stripe checkout.session.completed verification
AWS_ACCESS_KEY_ID=          # SES — welcome + contact emails
AWS_SECRET_ACCESS_KEY=
AWS_REGION=                 # e.g. us-east-1
SENDER_EMAIL_ADDRESS=       # SES verified sender, e.g. hello@storyincolor.com

# Storage bucket override. Functions normally pick up the default bucket
# from admin.app().options.storageBucket. The local emulator does NOT set
# this — export it explicitly when running `firebase emulators:start`.
GCLOUD_STORAGE_BUCKET=      # e.g. storyincolor.appspot.com (no gs:// prefix)
